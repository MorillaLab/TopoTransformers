   "source": [
    "# 2. Load model and preprocessors\n",
    "print('Loading model and preprocessors...')\n",
    "\n",
    "# Load trained model\n",
    "model = joblib.load('../models/trained_model.pkl')\n",
    "print(f'✅ Model loaded: {type(model).__name__}')\n",
    "\n",
    "# Load scaler\n",
    "scaler = joblib.load('../models/scaler.pkl')\n",
    "print('✅ Scaler loaded')\n",
    "\n",
    "# Load topological feature extractor (if available)\n",
    "try:\n",
    "    topo_extractor = joblib.load('../models/topological_extractors.pkl')\n",
    "    print('✅ Topological extractor loaded')\n",
    "except:\n",
    "    print('⚠️ Topological extractor not found - using synthetic features')\n",
    "    topo_extractor = None\n",
    "\n",
    "# Load feature names\n",
    "feature_df = pd.read_csv('../models/feature_names.csv')\n",
    "feature_names = feature_df['feature_name'].tolist()\n",
    "print(f'✅ Loaded {len(feature_names)} feature names')\n",
    "\n",
    "# Load SHAP explainer if available\n",
    "try:\n",
    "    explainer = joblib.load('../models/shap_explainer.pkl')\n",
    "    print('✅ SHAP explainer loaded')\n",
    "except:\n",
    "    print('⚠️ SHAP explainer not found - will create on the fly')\n",
    "    explainer = None"
