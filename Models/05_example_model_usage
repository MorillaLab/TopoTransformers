    "# 7. Interpret predictions with SHAP\n",
    "\n",
    "print('\\n' + '='*60)\n",
    "print('SHAP INTERPRETABILITY ANALYSIS')\n",
    "print('='*60)\n",
    "\n",
    "# Create SHAP explainer if not already loaded\n",
    "if explainer is None:\n",
    "    print('Creating SHAP explainer (this may take a few minutes)...')\n",
    "    # Use a subset of data for background\n",
    "    background = X_scaled[:50]\n",
    "    explainer = shap.KernelExplainer(model.predict_proba, background)\n",
    "    print('✅ SHAP explainer created')\n",
    "\n",
    "# Calculate SHAP values for a subset\n",
    "print('\\nCalculating SHAP values for 20 patients...')\n",
    "X_subset = X_scaled[:20]\n",
    "shap_values = explainer.shap_values(X_subset)[1]  # Class 1 (non-survivor) SHAP values\n",
    "\n",
    "print('✅ SHAP values calculated')\n",
    "\n",
    "# Summary plot\n",
    "plt.figure(figsize=(10, 6))\n",
    "shap.summary_plot(shap_values, X_subset, feature_names=feature_names[:X_subset.shape[1]], show=False)\n",
    "plt.title('SHAP Feature Importance Summary')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
