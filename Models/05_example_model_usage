   "source": [
    "# 8. Individual patient explanation\n",
    "\n",
    "def explain_patient(patient_idx):\n",
    "    \"\"\"Generate SHAP explanation for a specific patient\"\"\"\n",
    "    \n",
    "    print(f\"\\n{'='*60}\")\n",
    "    print(f\"EXPLANATION FOR PATIENT: {results_df.iloc[patient_idx]['patient_id']}\")\n",
    "    print(f\"{'='*60}\")\n",
    "    \n",
    "    # Get patient data\n",
    "    patient_data = X_scaled[patient_idx:patient_idx+1]\n",
    "    patient_raw = X.iloc[patient_idx]\n",
    "    \n",
    "    # Get prediction\n",
    "    risk = model.predict_proba(patient_data)[0, 1]\n",
    "    print(f\"\\nPredicted 1-year mortality risk: {risk*100:.1f}%\")\n",
    "    \n",
    "    # Calculate SHAP values for this patient\n",
    "    shap_value = explainer.shap_values(patient_data)[1][0]\n",
    "    \n",
    "    # Create waterfall plot\n",
    "    plt.figure(figsize=(10, 6))\n",
    "    \n",
    "    # Sort features by absolute SHAP value\n",
    "    feature_importance = list(zip(feature_names[:len(shap_value)], shap_value, patient_raw.values))\n",
    "    feature_importance.sort(key=lambda x: abs(x[1]), reverse=True)\n",
    "    \n",
    "    # Take top 10\n",
    "    top_features = feature_importance[:10]\n",
    "    \n",
    "    # Create horizontal bar chart\n",
    "    y_pos = np.arange(len(top_features))\n",
    "    colors = ['red' if x[1] > 0 else 'blue' for x in top_features]\n",
    "    \n",
    "    plt.barh(y_pos, [x[1] for x in top_features], color=colors, alpha=0.7)\n",
    "    plt.yticks(y_pos, [f\"{x[0]}\\n(value: {x[2]:.2f})\" for x in top_features])\n",
    "    plt.xlabel('SHAP Value (contribution to risk)')\n",
    "    plt.title(f'Top 10 Features Driving Prediction\\nBase risk: {risk:.2f}')\n",
    "    plt.axvline(x=0, color='black', linestyle='-', linewidth=0.5)\n",
    "    plt.grid(True, alpha=0.3, axis='x')\n",
    "    \n",
    "    # Add color legend\n",
    "    from matplotlib.patches import Patch\n",
    "    legend_elements = [Patch(facecolor='red', alpha=0.7, label='Increases risk'),\n",
    "                       Patch(facecolor='blue', alpha=0.7, label='Decreases risk')]\n",
    "    plt.legend(handles=legend_elements, loc='lower right')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return top_features\n",
    "\n",
    "# Explain a high-risk patient\n",
    "high_risk_idx = results_df['predicted_risk'].argmax()\n",
    "explain_patient(high_risk_idx)\n",
    "\n",
    "# Explain a low-risk patient\n",
    "low_risk_idx = results_df['predicted_risk'].argmin()\n",
    "explain_patient(low_risk_idx)"
