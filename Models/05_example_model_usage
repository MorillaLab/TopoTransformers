    "# 4. Make predictions for individual patients\n",
    "\n",
    "def predict_patient(patient_data, patient_id=None):\n",
    "    \"\"\"Predict mortality risk for a single patient\"\"\"\n",
    "    # Ensure correct shape\n",
    "    if patient_data.ndim == 1:\n",
    "        patient_data = patient_data.reshape(1, -1)\n",
    "    \n",
    "    # Scale features\n",
    "    patient_scaled = scaler.transform(patient_data)\n",
    "    \n",
    "    # Get prediction\n",
    "    risk_prob = model.predict_proba(patient_scaled)[0, 1]\n",
    "    risk_class = model.predict(patient_scaled)[0]\n",
    "    \n",
    "    result = {\n",
    "        'patient_id': patient_id,\n",
    "        'risk_probability': risk_prob,\n",
    "        'risk_class': 'High Risk' if risk_class == 1 else 'Low Risk',\n",
    "        'risk_percentage': f'{risk_prob*100:.1f}%'\n",
    "    }\n",
    "    \n",
    "    return result\n",
    "\n",
    "# Test on first 5 patients\n",
    "print('\\n' + '='*60)\n",
    "print('INDIVIDUAL PATIENT PREDICTIONS')\n",
    "print('='*60)\n",
    "\n",
    "for i in range(min(5, len(df))):\n",
    "    patient_data = X.iloc[i:i+1].values\n",
    "    patient_id = df.iloc[i]['patient_id'] if 'patient_id' in df.columns else f'Patient_{i+1}'\n",
    "    true_outcome = y.iloc[i] if y is not None else 'Unknown'\n",
    "    \n",
    "    result = predict_patient(patient_data, patient_id)\n",
    "    \n",
    "    print(f\"\\nPatient: {result['patient_id']}\")\n",
    "    print(f\"  Risk probability: {result['risk_percentage']}\")\n",
    "    print(f\"  Risk category: {result['risk_class']}\")\n",
    "    if y is not None:\n",
    "        true_status = 'Non-survivor' if true_outcome == 1 else 'Survivor'\n",
    "        correct = '✓' if (result['risk_class'] == 'High Risk' and true_outcome == 1) or \\\n",
    "                          (result['risk_class'] == 'Low Risk' and true_outcome == 0) else '✗'\n",
    "        print(f\"  True outcome: {true_status} {correct}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# 5. Batch prediction for all patients\n",
    "\n",
    "print('\\n' + '='*60)\n",
    "print('BATCH PREDICTION')\n",
    "print('='*60)\n",
    "\n",
    "# Scale all features\n",
    "X_scaled = scaler.transform(X)\n",
    "\n",
    "# Get probability predictions\n",
    "y_pred_proba = model.predict_proba(X_scaled)[:, 1]\n",
    "y_pred_class = model.predict(X_scaled)\n",
    "\n",
    "# Create results dataframe\n",
    "results_df = X.copy()\n",
    "results_df['patient_id'] = df['patient_id'] if 'patient_id' in df.columns else [f'P{i}' for i in range(len(df))]\n",
    "results_df['true_outcome'] = y if y is not None else np.nan\n",
    "results_df['predicted_risk'] = y_pred_proba\n",
    "results_df['predicted_class'] = y_pred_class\n",
    "results_df['risk_category'] = pd.cut(y_pred_proba, \n",
    "                                      bins=[0, 0.25, 0.5, 0.75, 1.0],\n",
    "                                      labels=['Low', 'Low-Intermediate', 'High-Intermediate', 'High'])\n",
    "\n",
    "print(f'✅ Generated predictions for {len(results_df)} patients')\n",
    "print('\\nFirst 5 predictions:')\n",
    "results_df[['patient_id', 'predicted_risk', 'risk_category']].head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# 6. Evaluate predictions (if true outcomes available)\n",
    "\n",
    "if y is not None:\n",
    "    print('\\n' + '='*60)\n",
    "    print('MODEL PERFORMANCE EVALUATION')\n",
    "    print('='*60)\n",
    "    \n",
    "    # Calculate metrics\n",
    "    from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score\n",
    "    \n",
    "    accuracy = accuracy_score(y, y_pred_class)\n",
    "    precision = precision_score(y, y_pred_class)\n",
    "    recall = recall_score(y, y_pred_class)\n",
    "    f1 = f1_score(y, y_pred_class)\n",
    "    \n",
    "    print(f'Accuracy:  {accuracy:.3f}')\n",
    "    print(f'Precision: {precision:.3f}')\n",
    "    print(f'Recall:    {recall:.3f}')\n",
    "    print(f'F1-score:  {f1:.3f}')\n",
    "    \n",
    "    # ROC curve\n",
    "    fpr, tpr, _ = roc_curve(y, y_pred_proba)\n",
    "    roc_auc = auc(fpr, tpr)\n",
    "    print(f'ROC-AUC:   {roc_auc:.3f}')\n",
    "    \n",
    "    # Confusion matrix\n",
    "    cm = confusion_matrix(y, y_pred_class)\n",
    "    \n",
    "    # Plot ROC and confusion matrix\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(12, 5))\n",
    "    \n",
    "    # ROC curve\n",
    "    axes[0].plot(fpr, tpr, color='darkorange', lw=2, label=f'ROC curve (AUC = {roc_auc:.2f})')\n",
    "    axes[0].plot([0, 1], [0, 1], color='navy', lw=2, linestyle='--')\n",
    "    axes[0].set_xlim([0.0, 1.0])\n",
    "    axes[0].set_ylim([0.0, 1.05])\n",
    "    axes[0].set_xlabel('False Positive Rate')\n",
    "    axes[0].set_ylabel('True Positive Rate')\n",
    "    axes[0].set_title('ROC Curve')\n",
    "    axes[0].legend(loc='lower right')\n",
    "    axes[0].grid(True, alpha=0.3)\n",
    "    \n",
    "    # Confusion matrix\n",
    "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=axes[1],\n",
    "                xticklabels=['Predicted Survivor', 'Predicted Non-survivor'],\n",
    "                yticklabels=['True Survivor', 'True Non-survivor'])\n",
    "    axes[1].set_title('Confusion Matrix')\n",
    "    axes[1].set_ylabel('True Label')\n",
    "    axes[1].set_xlabel('Predicted Label')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "else:\n",
    "    print('⚠️ No true outcomes available for evaluation')"
   ]
