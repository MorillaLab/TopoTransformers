    "# 3. Load synthetic patient data\n",
    "# (or use your own data - ensure same 76 features)\n",
    "\n",
    "print('Loading synthetic patient data...')\n",
    "df = pd.read_csv('../data/synthetic/synthetic_patient_data.csv')\n",
    "print(f'✅ Loaded {len(df)} synthetic patients')\n",
    "print(f'Columns: {df.columns.tolist()[:10]}... (showing first 10)')\n",
    "\n",
    "# Separate features and target\n",
    "feature_cols = [col for col in df.columns if col not in ['patient_id', 'mortality_y1']]\n",
    "X = df[feature_cols]\n",
    "y = df['mortality_y1'] if 'mortality_y1' in df.columns else None\n",
    "\n",
    "print(f'\\nFeature matrix shape: {X.shape}')\n",
    "print(f'Number of patients: {len(df)}')\n",
    "if y is not None:\n",
    "    print(f'Outcome distribution:\\n  Survivors: {(y==0).sum()} ({((y==0).sum()/len(y))*100:.1f}%)\\n  Non-survivors: {(y==1).sum()} ({((y==1).sum()/len(y))*100:.1f}%)')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Handle missing values (if any)\n",
    "if X.isnull().any().any():\n",
    "    print('⚠️ Missing values detected. Imputing with mean...')\n",
    "    X = X.fillna(X.mean())\n",
    "    print('✅ Missing values imputed')\n",
    "else:\n",
    "    print('✅ No missing values detected')"
   ]
  },
