{
    "model_name": "TopoAttention_v1.0",
    "model_type": "Multi-Layer Perceptron",
    "framework": "scikit-learn",
    "version": "1.0.0",
    "date_created": "2025-03-01",
    
    "architecture": {
        "input_dim": 76,
        "input_features": {
            "clinical": 49,
            "topological": 27,
            "total": 76
        },
        "hidden_layers": [
            {
                "layer": 1,
                "neurons": 64,
                "activation": "ReLU",
                "dropout": 0.2
            },
            {
                "layer": 2,
                "neurons": 32,
                "activation": "ReLU",
                "dropout": 0.2
            }
        ],
        "output_layer": {
            "neurons": 1,
            "activation": "Sigmoid"
        }
    },
    
    "training_parameters": {
        "optimizer": "Adam",
        "learning_rate": 0.001,
        "batch_size": 32,
        "epochs": 200,
        "early_stopping_patience": 10,
        "validation_split": 0.2,
        "l2_regularization": 0.01,
        "class_weight": { "0": 1.0, "1": 3.0 },
        "random_seed": 42
    },
    
    "topological_parameters": {
        "filtration": "Vietoris-Rips",
        "max_edge_length": 2.0,
        "homology_dimensions": [0, 1, 2],
        "persistence_image": {
            "resolution": [100, 100],
            "spread": 1.0,
            "sigma": 0.5
        },
        "extractors": [
            "number_of_points",
            "persistence_entropy",
            "bottleneck",
            "wasserstein",
            "landscape",
            "betti_curve",
            "heat_kernel",
            "silhouette",
            "persistence_image"
        ]
    },
    
    "performance_summary": {
        "auc_roc": 0.87,
        "auc_roc_ci": [0.81, 0.93],
        "accuracy": 0.90,
        "accuracy_ci": [0.85, 0.95],
        "sensitivity": 0.84,
        "specificity": 0.90,
        "f1_score": 0.83,
        "brier_score": 0.12,
        "ece": 0.08
    }
}
